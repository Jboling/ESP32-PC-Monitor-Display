# Copy to .env in the project root and fill in your values.
# .env is gitignored — never commit real credentials.

WIFI_SSID=YourWiFiName
WIFI_PASSWORD=YourWiFiPassword

# mDNS hostname (agent connects to <hostname>.local)
DEVICE_HOSTNAME=esp32-pc-monitor

# TCP port for JSON stats (must match on ESP32 and PC agent)
STATS_PORT=5000
